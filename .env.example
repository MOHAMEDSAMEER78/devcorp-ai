# DevCorp AI — Environment Configuration

# Application
ENVIRONMENT=development
DEBUG=true

# Databases
POSTGRES_URL=postgresql://postgres:postgrespassword@localhost:5432/devcorp
REDIS_URL=redis://localhost:6379/0

# Inference Gateway (LiteLLM)
LITELLM_PROXY_URL=http://localhost:4000
LITELLM_MASTER_KEY=sk-devcorp-master-key
PROVIDERS_CONFIG_PATH=providers.yaml

# Local vLLM (Set to true if local GPU inference server is running)
LOCAL_GPU_ENABLED=false
LOCAL_VLLM_URL=http://localhost:8000/v1

# Foundation Model Provider API Keys
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GROQ_API_KEY=your_groq_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Standup & Dashboard
DASHBOARD_PORT=3000
DASHBOARD_AUTH_SECRET=dev-auth-secret-key-change-in-prod
GOOGLE_CALENDAR_CREDENTIALS_JSON=
MS_TEAMS_BOT_APP_ID=
MS_TEAMS_BOT_APP_PASSWORD=
